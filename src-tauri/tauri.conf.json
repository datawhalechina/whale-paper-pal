{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhalePaper",
  "version": "0.1.0",
  "identifier": "io.whalepaper.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WhalePaper",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "pet",
        "title": "WhalePaper Pet",
        "url": "/?pet=1",
        "width": 351,
        "height": 470,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/models/doclayout_yolo_docstructbench_imgsz1024.onnx": "models/doclayout_yolo_docstructbench_imgsz1024.onnx",
      "resources/models/LICENSE.DocLayout-YOLO.txt": "models/LICENSE.DocLayout-YOLO.txt",
      "resources/models/README.md": "models/README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
